                <mxCell id="22" value="before each tool call:&lt;br&gt;grounded?&lt;div&gt;&amp;nbsp;appropriate?&amp;nbsp;&lt;/div&gt;&lt;div&gt;clarify?&lt;/div&gt;" style="endArrow=block;html=1;fontSize=10;dashed=1;strokeColor=#ED7100;" edge="1" parent="1" source="11" target="13">
                    <mxGeometry x="-0.0357" y="-37" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="23" value="Flow: browser loads the Amplify SPA and calls the API; API Gateway proxies to Lambda; Lambda (IAM-scoped) invokes the deployed AgentCore agent; the Strands agent uses&amp;nbsp;&lt;div&gt;Amazon Bedrock for the reply and Strands Decider 2B to gate every tool call. A deterministic fail-closed policy decides PROCEED / CLARIFY / DENY.&lt;/div&gt;" style="text;html=1;strokeColor=#CCCCCC;fillColor=#F7F7F7;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#687078;" vertex="1" parent="1">
                    <mxGeometry x="360" y="840" width="820" height="70" as="geometry"/>
                </mxCell>
